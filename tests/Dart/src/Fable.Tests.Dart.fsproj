<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <XunitAutoGeneratedEntryPoint Condition="'$(FABLE_COMPILER)' == 'True'">false</XunitAutoGeneratedEntryPoint>
    <XunitRegisterBuiltInRunnerReporters Condition="'$(FABLE_COMPILER)' == 'True'">false</XunitRegisterBuiltInRunnerReporters>
    <XunitRegisterBuiltInResultWriters Condition="'$(FABLE_COMPILER)' == 'True'">false</XunitRegisterBuiltInResultWriters>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <LangVersion>preview</LangVersion>
    <RootNamespace>Fable.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Fable.Core/Fable.Core.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Tests.Util.fs" />
    <Compile Include="ArithmeticTests.fs" />
    <Compile Include="AsyncTests.fs" />
    <Compile Include="RandomTests.fs" />
    <Compile Include="ArrayTests.fs" />
    <Compile Include="ComparisonTests.fs" />
    <Compile Include="CustomOperatorTests.fs" />
    <Compile Include="DateTimeTests.fs" />
    <Compile Include="DictionaryTests.fs" />
    <Compile Include="EnumerableTests.fs" />
    <Compile Include="EnumTests.fs" />
    <Compile Include="HashSetTests.fs" />
    <Compile Include="InlineIfLambdaTests.fs" />
    <Compile Include="ListTests.fs" />
    <Compile Include="MapTests.fs" />
    <Compile Include="MiscTests.fs" />
    <Compile Include="NullnessTests.fs" />
    <Compile Include="OptionTests.fs" />
    <Compile Include="QuotationTests.fs" />
    <Compile Include="RecordTests.fs" />
    <Compile Include="RegexTests.fs" />
    <Compile Include="ResizeArrayTests.fs" />
    <Compile Include="ResultTests.fs" />
    <Compile Include="RuneTests.fs" />
    <Compile Include="SeqTests.fs" />
    <Compile Include="SeqExpressionTests.fs" />
    <Compile Include="SetTests.fs" />
    <Compile Include="StringTests.fs" />
    <Compile Include="SudokuTests.fs" />
    <Compile Include="TailCallTests.fs" />
    <Compile Include="TimeSpanTests.fs" />
    <Compile Include="TupleTests.fs" />
    <Compile Include="TypeTests.fs" />
    <Compile Include="UnionTests.fs" />
    <Content Include="..\main.dart" />
  </ItemGroup>
</Project>
